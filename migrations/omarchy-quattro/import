#!/bin/bash

set -euo pipefail

source_dir=${PARM_SOURCE_DIR:-/usr/share/parm}
target_home=${PARM_TARGET_HOME:-$HOME}
parm_config="$target_home/.config/parm"
hypr_config="$target_home/.config/hypr"
imported="$parm_config/imported"

mkdir -p \
  "$parm_config/hypr" \
  "$parm_config/zsh/functions" \
  "$imported" \
  "$hypr_config" \
  "$target_home/.config/alacritty" \
  "$target_home/.config/foot" \
  "$target_home/.config/uwsm" \
  "$target_home/.local/share/parm/wallpapers"

install -m 0644 "$source_dir/config/hypr/hyprland.lua" "$hypr_config/hyprland.lua"
install -m 0644 "$source_dir/config/hypr/hypridle.conf" "$hypr_config/hypridle.conf"
install -m 0644 "$source_dir/config/hypr/hyprlock.conf" "$hypr_config/hyprlock.conf"

if [[ -f $hypr_config/monitors.lua ]]; then
  install -m 0644 "$hypr_config/monitors.lua" "$parm_config/hypr/imported-monitors.lua"
fi

for name in input.lua bindings.lua looknfeel.lua autostart.lua; do
  [[ -f $hypr_config/$name ]] &&
    install -m 0644 "$hypr_config/$name" "$imported/$name"
done

if [[ -f $target_home/.config/omarchy/shell.json ]]; then
  install -m 0644 "$target_home/.config/omarchy/shell.json" "$imported/omarchy-shell.json"
fi

background="$target_home/.local/state/omarchy/current/background"
if [[ -e $background ]]; then
  resolved=$(readlink -f -- "$background")
  if [[ -f $resolved ]]; then
    destination="$target_home/.local/share/parm/wallpapers/$(basename -- "$resolved")"
    install -m 0644 "$resolved" "$destination"
    temp=$(mktemp --tmpdir="$parm_config" .config.XXXXXX)
    jq --arg wallpaper "$destination" '.appearance.wallpaper = $wallpaper' \
      "$parm_config/config.json" >"$temp"
    mv -f -- "$temp" "$parm_config/config.json"
  fi
fi

temp=$(mktemp --tmpdir="$parm_config" .config.XXXXXX)
jq --arg user "$(basename -- "$target_home")" '.login.user = $user' \
  "$parm_config/config.json" >"$temp"
mv -f -- "$temp" "$parm_config/config.json"

cat >"$target_home/.config/alacritty/alacritty.toml" <<'EOF'
general.import = ["~/.config/alacritty/themes/parm.toml"]

[window]
decorations = "None"
dynamic_padding = true

[font]
normal = { family = "JetBrainsMono Nerd Font", style = "Regular" }
size = 11
EOF

cat >"$target_home/.config/foot/foot.ini" <<'EOF'
include=~/.config/foot/parm-theme.ini
font=JetBrainsMono Nerd Font:size=11
pad=8x8
EOF

for uwsm_file in env default; do
  destination="$target_home/.config/uwsm/$uwsm_file"
  backup="$imported/uwsm-$uwsm_file.before-parm"
  if [[ -f $destination ]] &&
    ! grep -q "# BEGIN PARM UWSM" "$destination" &&
    [[ ! -f $backup ]]; then
    install -m 0644 "$destination" "$backup"
  fi
  install -m 0644 "$source_dir/config/uwsm/$uwsm_file" "$destination"
done

zprofile="$target_home/.zprofile"
touch "$zprofile"
profile_temp=$(mktemp --tmpdir="$target_home" .zprofile.XXXXXX)
awk '
  /^# BEGIN PARM SESSION$/ { managed = 1; next }
  /^# END PARM SESSION$/ { managed = 0; next }
  !managed { print }
' "$zprofile" >"$profile_temp"
cat >>"$profile_temp" <<'EOF'

# BEGIN PARM SESSION
_parm_tty=$(tty 2>/dev/null || true)
if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]] &&
  [[ ${XDG_VTNR:-0} == 1 || $_parm_tty == /dev/tty1 ]]; then
  exec uwsm start -g -1 -e -D Hyprland hyprland.desktop
fi
unset _parm_tty
# END PARM SESSION
EOF
mv -f -- "$profile_temp" "$zprofile"

zshrc="$target_home/.zshrc"
if [[ -f $zshrc ]] && grep -q 'OMARCHY_PATH/default/bash/fns' "$zshrc"; then
  cp -a -- "$zshrc" "$imported/zshrc.before-parm"
  sed -i \
    's#for f in \$OMARCHY_PATH/default/bash/fns/\*; do source "\$f"; done#for f in "$HOME"/.config/parm/zsh/functions/*(N); do source "$f"; done#' \
    "$zshrc"
fi

mkdir -p "$target_home/.config/mise"
jq -r '
  .development.mise
  | to_entries
  | ["[tools]"] + map("\"\(.key)\" = \"\(.value)\"")
  | .[]
' "$parm_config/config.json" >"$target_home/.config/mise/config.toml"

applications="$target_home/.local/share/applications"
mkdir -p "$applications"
jq -c '.webapps[] | select(.enabled)' "$parm_config/config.json" |
  while IFS= read -r webapp; do
    id=$(jq -r '.id' <<<"$webapp")
    name=$(jq -r '.name' <<<"$webapp")
    icon=$(jq -r '.icon' <<<"$webapp")
    cat >"$applications/parm-webapp-$id.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=parmctl webapp launch $id
Icon=$icon
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF
    chmod 0644 "$applications/parm-webapp-$id.desktop"
  done

echo "Imported Omarchy Quattro user configuration into $parm_config"
