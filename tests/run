#!/usr/bin/env bash

set -euo pipefail

TEST_ROOT=$(mktemp -d)
TEST_HOME="$TEST_ROOT/home"
TEST_STATE="$TEST_ROOT/state"
mkdir -p -- "$TEST_HOME" "$TEST_STATE"

cleanup() {
  rm -rf -- "$TEST_ROOT"
}
trap cleanup EXIT

REPO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

run_setup() {
  PARM_CONFIG_HOME="$TEST_HOME" \
    PARM_CONFIG_STATE_HOME="$TEST_STATE" \
    PARM_CONFIG_SKIP_OMARCHY_CHECK=1 \
    PARM_CONFIG_SKIP_PROFILE_CHECK=1 \
    "$REPO_ROOT/setup" "$@"
}

assert_file_equals() {
  local expected=$1 actual=$2
  cmp -s -- "$expected" "$actual" || {
    printf 'Mismatch: %s != %s\n' "$expected" "$actual" >&2
    exit 1
  }
}

# Empty-home status is valid JSON and reports missing files.
run_setup status --json |
  jq -e 'length > 0 and all(.[]; .state == "missing")' >/dev/null

# Dry-run must not write.
run_setup install --dry-run >/dev/null
[[ ! -e $TEST_HOME/.zshrc ]]

# Clean install produces an exact managed tree.
run_setup install >/dev/null
run_setup status --json |
  jq -e 'all(.[]; .state == "matching")' >/dev/null
assert_file_equals "$REPO_ROOT/home/.zshrc" "$TEST_HOME/.zshrc"

# Conflicts refuse atomically.
printf 'local conflict\n' >"$TEST_HOME/.zshrc"
if run_setup install >/dev/null 2>&1; then
  echo "Expected conflict refusal" >&2
  exit 1
fi
[[ $(<"$TEST_HOME/.zshrc") == "local conflict" ]]

# Force creates a backup and replaces the conflict.
run_setup install --force >/dev/null
assert_file_equals "$REPO_ROOT/home/.zshrc" "$TEST_HOME/.zshrc"
BACKUP_ID=$(run_setup backups | head -n1)
[[ -n $BACKUP_ID ]]

# Restore returns the pre-force content.
run_setup restore "$BACKUP_ID" --yes >/dev/null
[[ $(<"$TEST_HOME/.zshrc") == "local conflict" ]]

# Profile installation adds the host-specific files.
run_setup install --force --profile parm-laptop >/dev/null
assert_file_equals \
  "$REPO_ROOT/profiles/parm-laptop/home/.config/hypr/monitors.lua" \
  "$TEST_HOME/.config/hypr/monitors.lua"
assert_file_equals \
  "$REPO_ROOT/profiles/parm-laptop/home/.config/hypr/profile.lua" \
  "$TEST_HOME/.config/hypr/profile.lua"

# Capture previews drift without writing to the repository.
printf '\n# live-only test\n' >>"$TEST_HOME/.config/hypr/input.lua"
before=$(sha256sum "$REPO_ROOT/home/.config/hypr/input.lua")
run_setup capture --profile parm-laptop >/dev/null
after=$(sha256sum "$REPO_ROOT/home/.config/hypr/input.lua")
[[ $before == "$after" ]]

# Force/restore preserves an existing symlink as a symlink.
printf 'linked zsh\n' >"$TEST_ROOT/linked-zshrc"
ln -sfn -- "$TEST_ROOT/linked-zshrc" "$TEST_HOME/.zshrc"
run_setup install --force >/dev/null
SYMLINK_BACKUP=$(run_setup backups | head -n1)
run_setup restore "$SYMLINK_BACKUP" --yes >/dev/null
[[ -L $TEST_HOME/.zshrc ]]
[[ $(readlink -- "$TEST_HOME/.zshrc") == "$TEST_ROOT/linked-zshrc" ]]

# A known legacy checksum is retired only under --force.
mkdir -p -- "$TEST_HOME/.config/omarchy"
printf '{}\n' >"$TEST_HOME/.config/omarchy/bar.json"
run_setup install --force >/dev/null
[[ ! -e $TEST_HOME/.config/omarchy/bar.json ]]

# Capture-write is tested in an isolated repository copy.
CAPTURE_REPO="$TEST_ROOT/repository-copy"
mkdir -p -- "$CAPTURE_REPO"
tar --exclude=.git -C "$REPO_ROOT" -cf - . |
  tar -C "$CAPTURE_REPO" -xf -
git -C "$CAPTURE_REPO" init -q
git -C "$CAPTURE_REPO" config user.name Test
git -C "$CAPTURE_REPO" config user.email test@example.invalid
git -C "$CAPTURE_REPO" add .
git -C "$CAPTURE_REPO" commit -qm baseline

capture_setup() {
  PARM_CONFIG_HOME="$TEST_HOME" \
    PARM_CONFIG_STATE_HOME="$TEST_STATE" \
    PARM_CONFIG_SKIP_OMARCHY_CHECK=1 \
    PARM_CONFIG_SKIP_PROFILE_CHECK=1 \
    "$CAPTURE_REPO/setup" "$@"
}

printf '\n# captured change\n' >>"$TEST_HOME/.config/hypr/looknfeel.lua"
capture_setup capture --write --profile parm-laptop >/dev/null
assert_file_equals \
  "$CAPTURE_REPO/home/.config/hypr/looknfeel.lua" \
  "$TEST_HOME/.config/hypr/looknfeel.lua"

# Absolute home paths are rejected and do not overwrite the repository copy.
printf '\n# /home/not-portable/private\n' >>"$TEST_HOME/.config/hypr/input.lua"
portable_before=$(sha256sum "$CAPTURE_REPO/home/.config/hypr/input.lua")
if capture_setup capture --write --force --profile parm-laptop >/dev/null 2>&1; then
  echo "Expected non-portable capture rejection" >&2
  exit 1
fi
portable_after=$(sha256sum "$CAPTURE_REPO/home/.config/hypr/input.lua")
[[ $portable_before == "$portable_after" ]]

echo "All tests passed"
