{
  "schemaVersion": 1,
  "appearance": {
    "wallpaper": "",
    "mode": "auto",
    "lightAt": "07:00",
    "darkAt": "19:00",
    "timezone": "Asia/Kolkata",
    "scheme": "scheme-tonal-spot",
    "contrast": 0
  },
  "shell": {
    "bar": {
      "position": "top",
      "height": 42,
      "clockFormat": "dddd HH:mm"
    },
    "weather": {
      "enabled": true,
      "location": ""
    },
    "optionalModules": {
      "tailscale": false,
      "dropbox": false
    }
  },
  "display": {
    "monitors": []
  },
  "input": {
    "keyboardLayout": "us",
    "naturalScroll": false,
    "touchpadSpeed": 0
  },
  "keybindings": [
    {
      "keys": "SUPER + RETURN",
      "label": "Terminal",
      "command": "uwsm-app -- alacritty",
      "enabled": true
    },
    {
      "keys": "SUPER + SPACE",
      "label": "Launcher",
      "command": "parmctl shell launcher",
      "enabled": true
    },
    {
      "keys": "SUPER + W",
      "label": "Close window",
      "command": "@dispatcher:close",
      "enabled": true
    },
    {
      "keys": "SUPER + F",
      "label": "Fullscreen",
      "command": "@dispatcher:fullscreen",
      "enabled": true
    },
    {
      "keys": "SUPER + CTRL + SHIFT + F",
      "label": "Files",
      "command": "uwsm-app -- dolphin",
      "enabled": true
    },
    {
      "keys": "SUPER + SHIFT + K",
      "label": "Kate",
      "command": "uwsm-app -- kate",
      "enabled": true
    },
    {
      "keys": "SUPER + SHIFT + M",
      "label": "Shuffle Videos",
      "command": "uwsm-app -- mpv --shuffle ~/Videos",
      "enabled": true
    },
    {
      "keys": "SUPER + CTRL + COMMA",
      "label": "Parm Settings",
      "command": "parmctl settings",
      "enabled": true
    }
  ],
  "power": {
    "screensaverSeconds": 600,
    "lockSeconds": 900,
    "profile": "balanced"
  },
  "login": {
    "ttyAutologin": true,
    "user": ""
  },
  "webapps": [
    {
      "id": "chatgpt",
      "name": "ChatGPT",
      "url": "https://chatgpt.com",
      "icon": "applications-internet",
      "keybinding": "SUPER + SHIFT + G",
      "enabled": true
    },
    {
      "id": "claude",
      "name": "Claude",
      "url": "https://claude.ai",
      "icon": "applications-internet",
      "keybinding": "SUPER + SHIFT + A",
      "enabled": true
    },
    {
      "id": "calendar",
      "name": "Google Calendar",
      "url": "https://calendar.google.com",
      "icon": "office-calendar",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "gmail",
      "name": "Gmail",
      "url": "https://mail.google.com",
      "icon": "internet-mail",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "url": "https://youtube.com",
      "icon": "applications-multimedia",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "whatsapp",
      "name": "WhatsApp",
      "url": "https://web.whatsapp.com",
      "icon": "applications-internet",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "gmail-compose",
      "name": "New Email",
      "url": "https://mail.google.com/mail/u/0/#compose",
      "icon": "mail-message-new",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "messages",
      "name": "Google Messages",
      "url": "https://messages.google.com/web",
      "icon": "applications-internet",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "photos",
      "name": "Google Photos",
      "url": "https://photos.google.com",
      "icon": "applications-graphics",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "maps",
      "name": "Google Maps",
      "url": "https://maps.google.com",
      "icon": "applications-internet",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "x",
      "name": "X",
      "url": "https://x.com",
      "icon": "applications-internet",
      "keybinding": "",
      "enabled": true
    },
    {
      "id": "x-post",
      "name": "Post on X",
      "url": "https://x.com/compose/post",
      "icon": "document-edit",
      "keybinding": "",
      "enabled": true
    }
  ],
  "development": {
    "mise": {
      "biome": "2.5.5",
      "bun": "1.3.14",
      "codex": "0.145.0",
      "deno": "2.9.4",
      "gh": "2.96.0",
      "github:can1357/oh-my-pi": "17.1.5",
      "go": "1.26.5",
      "node": "26.5.0",
      "pnpm": "11.17.0",
      "python": "3.14.6",
      "rust": "1.97.1"
    },
    "dockerEnabled": false
  },
  "updates": {
    "channel": "stable",
    "automaticCheck": true
  },
  "recovery": {
    "configBackups": 10,
    "snapperSnapshots": 5
  }
}
