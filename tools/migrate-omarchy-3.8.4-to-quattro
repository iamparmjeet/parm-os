#!/bin/bash

set -euo pipefail

# The official standalone migrator is pinned so that this wrapper remains
# auditable. The edge repository selected below still supplies current Quattro
# packages. Update both values together after reviewing upstream changes.
UPGRADER_COMMIT=9b693cca63d111fc3faba16aea149d226881b427
UPGRADER_SHA256=df6a09b65fb4d59224706bb50c6eb749c88cdf918ab3873ac2a23298507d371e
UPGRADER_URL="https://raw.githubusercontent.com/basecamp/omarchy/$UPGRADER_COMMIT/bin/omarchy-upgrade-to-quattro"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '==> %s\n' "$*"
}

warn() {
  printf 'WARNING: %s\n' "$*" >&2
}

usage() {
  printf '%s\n' \
    'Safely migrate a fresh Omarchy 3.8.x VM to package-backed Quattro.' \
    '' \
    'Usage:' \
    '  migrate-omarchy-3.8.4-to-quattro [--inspect] [--reboot]' \
    '' \
    'Options:' \
    '  --inspect  Run read-only compatibility checks, then exit.' \
    '  --reboot   Ask the official upgrader to reboot when it finishes.' \
    '  --help     Show this help.' \
    '' \
    'This pre-release helper is deliberately restricted to QEMU/KVM and' \
    'VirtualBox guests. It never clones Quattro into ~/.local/share and it' \
    'never replaces ~/.config.'
}

inspect_only=0
reboot_after=0

while (($#)); do
  case "$1" in
  --inspect)
    inspect_only=1
    ;;
  --reboot)
    reboot_after=1
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    die "Unknown option: $1"
    ;;
  esac
  shift
done

((EUID != 0)) || die "Run this as your normal Omarchy user, not as root."
[[ -f /etc/arch-release ]] || die "Arch Linux was not detected."

virt=$(systemd-detect-virt --vm 2>/dev/null || true)
[[ $virt =~ ^(kvm|qemu|oracle)$ ]] ||
  die "This helper only runs in a QEMU/KVM or VirtualBox guest (detected: ${virt:-none})."

if [[ -f /usr/share/omarchy/shell/shell.qml ]]; then
  note "This VM already has the package-backed Quattro shell."
  exit 0
fi

command -v omarchy >/dev/null 2>&1 ||
  die "Omarchy is not installed. Start from a fresh Omarchy 3.8.4 installation."

version_text=
if command -v omarchy-version >/dev/null 2>&1; then
  version_text=$(omarchy-version 2>/dev/null || true)
elif [[ -r ${OMARCHY_PATH:-$HOME/.local/share/omarchy}/version ]]; then
  version_text=$(<"${OMARCHY_PATH:-$HOME/.local/share/omarchy}/version")
else
  version_text=$(omarchy version 2>/dev/null || true)
fi

if [[ $version_text =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
  source_version=${BASH_REMATCH[0]}
  source_major=${BASH_REMATCH[1]}
  source_minor=${BASH_REMATCH[2]}
  source_patch=${BASH_REMATCH[3]}
else
  die "Could not determine the installed Omarchy version."
fi

((source_major == 3 && source_minor == 8 && source_patch >= 3)) ||
  die "Expected the Omarchy 3.8.4 ISO family; detected $source_version."

required_commands=(
  curl
  df
  pacman
  sha256sum
  sudo
  tar
  zstd
)
for command_name in "${required_commands[@]}"; do
  command -v "$command_name" >/dev/null 2>&1 ||
    die "Required command is missing: $command_name"
done

[[ ! -e /var/lib/pacman/db.lck ]] ||
  die "pacman is busy or left /var/lib/pacman/db.lck behind. Resolve that before migrating."

root_available_kib=$(df -Pk / | awk 'NR == 2 {print $4}')
boot_available_kib=$(df -Pk /boot | awk 'NR == 2 {print $4}')
((root_available_kib >= 8 * 1024 * 1024)) ||
  die "At least 8 GiB must be free on the root filesystem."
((boot_available_kib >= 350 * 1024)) ||
  die "At least 350 MiB must be free on /boot."

note "Compatible source detected: Omarchy $source_version on $virt."
note "Migration mode: package-backed Quattro from the edge channel (not --dev)."
note "Official upgrader commit: $UPGRADER_COMMIT"

if ((inspect_only)); then
  note "Read-only inspection passed. No files were changed."
  exit 0
fi

[[ -t 0 && -t 1 ]] ||
  die "Migration requires an interactive terminal."

note "Checking sudo access."
sudo -v

upgrade_file=$(mktemp)
cleanup() {
  rm -f -- "$upgrade_file"
}
trap cleanup EXIT

note "Downloading and authenticating the pinned official migrator."
curl -fL --proto '=https' --tlsv1.2 "$UPGRADER_URL" -o "$upgrade_file"
printf '%s  %s\n' "$UPGRADER_SHA256" "$upgrade_file" | sha256sum -c -
chmod 0700 "$upgrade_file"

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
backup_dir="$HOME/.local/state/omarchy/quattro-wrapper-backups/$timestamp"
mkdir -p "$backup_dir"
chmod 0700 "$backup_dir"

note "Writing recovery data to $backup_dir"
pacman -Qqe >"$backup_dir/packages-explicit.txt"
pacman -Qq >"$backup_dir/packages-all.txt"
pacman -Qm >"$backup_dir/packages-foreign.txt" || true
systemctl --user list-unit-files >"$backup_dir/user-units.txt" 2>&1 || true
findmnt >"$backup_dir/mounts.txt"

if [[ -d $HOME/.local/share/omarchy/.git ]]; then
  git -C "$HOME/.local/share/omarchy" rev-parse HEAD \
    >"$backup_dir/legacy-omarchy-commit.txt" 2>/dev/null || true
  git -C "$HOME/.local/share/omarchy" status --short \
    >"$backup_dir/legacy-omarchy-status.txt" 2>/dev/null || true
fi

user_backup_paths=()
for candidate in \
  .bashrc \
  .profile \
  .zshrc \
  .config/alacritty \
  .config/foot \
  .config/ghostty \
  .config/hypr \
  .config/kitty \
  .config/omarchy \
  .config/quickshell \
  .config/uwsm \
  .local/share/applications; do
  [[ -e $HOME/$candidate ]] && user_backup_paths+=("$candidate")
done

if ((${#user_backup_paths[@]})); then
  tar --zstd -C "$HOME" -cf "$backup_dir/user-config.tar.zst" \
    "${user_backup_paths[@]}"
fi

system_backup_paths=()
for candidate in \
  etc/default \
  etc/fstab \
  etc/limine-entry-tool.conf \
  etc/limine-snapper-sync.conf \
  etc/mkinitcpio.conf \
  etc/mkinitcpio.d \
  etc/omarchy.conf \
  etc/pacman.conf \
  etc/pacman.d \
  etc/sddm.conf \
  etc/sddm.conf.d; do
  [[ -e /$candidate ]] && system_backup_paths+=("$candidate")
done

if ((${#system_backup_paths[@]})); then
  sudo tar --zstd -C / -cf "$backup_dir/system-config.tar.zst" \
    "${system_backup_paths[@]}"
  sudo chown "$USER:$(id -gn)" "$backup_dir/system-config.tar.zst"
fi

if command -v omarchy-debug >/dev/null 2>&1; then
  omarchy-debug --no-sudo --print >"$backup_dir/debug-before.txt" 2>&1 || true
fi

if command -v omarchy-snapshot >/dev/null 2>&1 &&
  command -v snapper >/dev/null 2>&1; then
  note "Creating a pre-migration Snapper snapshot."
  omarchy-snapshot create ||
    die "Snapper snapshot creation failed. The migration has not started."
else
  die "Snapper integration is unavailable. The migration has not started; file backups remain at $backup_dir."
fi

(
  cd "$backup_dir"
  sha256sum ./*.txt ./*.tar.zst 2>/dev/null >SHA256SUMS || true
)

printf '%s\n' \
  "Source: Omarchy $source_version" \
  "Virtualization: $virt" \
  "UTC start: $timestamp" \
  "Official upgrader: $UPGRADER_COMMIT" \
  "Channel: edge" \
  "Package mode: production (omarchy + omarchy-settings)" \
  >"$backup_dir/manifest.txt"

printf '\n'
printf '%s\n' \
  'The following official migration changes packages, networking, boot files,' \
  'Hyprland configuration, and the Quickshell session.' \
  '' \
  "Recovery files: $backup_dir" \
  'A Snapper snapshot was created successfully.' \
  'No current configuration will be copied over Quattro configuration.' \
  ''
printf 'Type MIGRATE-TO-QUATTRO to continue: '
IFS= read -r confirmation
[[ $confirmation == MIGRATE-TO-QUATTRO ]] ||
  die "Confirmation did not match. No migration changes were made."

upgrade_args=(
  --yes
  --channel edge
  --user "$USER"
)
((reboot_after)) && upgrade_args+=(--reboot)

note "Starting the official Omarchy migration."
if ((!reboot_after)); then
  warn "When the official script asks about rebooting, choose No so this wrapper can run post-migration checks."
fi
"$upgrade_file" "${upgrade_args[@]}"

postcheck_failed=0
for package_name in omarchy omarchy-settings omarchy-keyring; do
  if pacman -Q "$package_name" >>"$backup_dir/packages-after.txt" 2>&1; then
    note "Installed package verified: $package_name"
  else
    warn "Expected package is missing: $package_name"
    postcheck_failed=1
  fi
done

for dev_package in omarchy-dev omarchy-settings-dev; do
  if pacman -Q "$dev_package" >/dev/null 2>&1; then
    warn "Unexpected development package is installed: $dev_package"
    postcheck_failed=1
  fi
done

for required_path in \
  /usr/share/omarchy/shell/shell.qml \
  /usr/share/omarchy/default/hypr; do
  if [[ ! -e $required_path ]]; then
    warn "Expected Quattro path is missing: $required_path"
    postcheck_failed=1
  fi
done

if [[ -e /etc/omarchy.conf ]]; then
  warn "/etc/omarchy.conf still exists; package-backed Quattro should not need a development checkout."
  postcheck_failed=1
fi

if command -v omarchy-debug >/dev/null 2>&1; then
  omarchy-debug --no-sudo --print >"$backup_dir/debug-after.txt" 2>&1 || true
fi

if ((postcheck_failed)); then
  printf '%s\n' failed >"$backup_dir/result"
  die "Migration returned, but post-checks failed. Do not delete the backup or snapshot; inspect $backup_dir."
fi

printf '%s\n' passed >"$backup_dir/result"
note "Quattro package and layout checks passed."
note "Recovery data remains at $backup_dir"
if ((!reboot_after)); then
  note "Reboot with: systemctl reboot"
fi
