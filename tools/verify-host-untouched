#!/bin/bash

set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
baseline="$repo/.host-baseline.sha256"

collect() {
  local paths=(
    "$HOME/.config/hypr"
    "$HOME/.config/omarchy"
    "$HOME/.config/alacritty"
    "$HOME/.config/foot"
    "$HOME/.config/uwsm"
    "$HOME/.zshrc"
    "$HOME/.zprofile"
    /etc/pacman.conf
    /etc/pacman.d/mirrorlist
    /etc/sddm.conf.d
    /etc/limine-entry-tool.d
    /etc/mkinitcpio.conf.d
    /boot/limine.conf
  )

  local path
  for path in "${paths[@]}"; do
    if [[ -f $path ]]; then
      sha256sum "$path"
    elif [[ -d $path ]]; then
      find "$path" -xdev -type f -print0 2>/dev/null |
        sort -z |
        xargs -0 -r sha256sum
    fi
  done
}

case "${1:-}" in
  capture)
    collect >"$baseline"
    echo "Captured host configuration baseline: $baseline"
    ;;
  verify)
    [[ -f $baseline ]] || {
      echo "No baseline exists; run: $0 capture" >&2
      exit 1
    }
    current=$(mktemp)
    trap 'rm -f -- "$current"' EXIT
    collect >"$current"
    if diff -u "$baseline" "$current"; then
      echo "Host configuration is unchanged."
    else
      echo "Host configuration changed after the baseline." >&2
      exit 1
    fi
    ;;
  *)
    echo "Usage: $0 capture|verify" >&2
    exit 2
    ;;
esac
