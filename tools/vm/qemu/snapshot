#!/bin/bash

set -euo pipefail

name=${1:-parm-qemu}
snapshot=${2:-}
[[ -n $snapshot ]] || {
  echo "Usage: $0 <vm-name> <snapshot-name>" >&2
  exit 2
}
[[ $snapshot =~ ^[a-zA-Z0-9._-]+$ ]] || {
  echo "Invalid snapshot name: $snapshot" >&2
  exit 1
}

virsh dominfo "$name" >/dev/null
virsh snapshot-create-as "$name" "$snapshot" \
  "Parm validation snapshot $snapshot" --atomic
