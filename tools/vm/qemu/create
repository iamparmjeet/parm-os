#!/bin/bash

set -euo pipefail

name=${1:-parm-qemu}
iso=${2:-$HOME/Downloads/omarchy-3.8.4.iso}
vm_dir=${PARM_VM_DIR:-$HOME/VMs/parm}
connection=${PARM_LIBVIRT_URI:-qemu:///session}
disk="$vm_dir/$name.qcow2"
xml="$vm_dir/$name.xml"

[[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || {
  echo "Invalid VM name: $name" >&2
  exit 1
}
[[ -f $iso ]] || {
  echo "Omarchy ISO not found: $iso" >&2
  exit 1
}
virsh --connect "$connection" uri >/dev/null 2>&1 || {
  echo "Cannot connect to libvirt at $connection." >&2
  exit 1
}
virsh --connect "$connection" domcapabilities --virttype kvm 2>/dev/null |
  grep -q '<value>efi</value>' || {
  echo "libvirt at $connection does not report usable EFI firmware." >&2
  exit 1
}
virsh --connect "$connection" dominfo "$name" >/dev/null 2>&1 && {
  echo "VM already exists: $name" >&2
  exit 1
}

resume=0
if [[ -e $disk || -e $xml ]]; then
  if [[ -f $disk && -f $xml ]]; then
    resume=1
    printf 'Resume registering QEMU VM %s with existing disk %s? [y/N] ' \
      "$name" "$disk"
  else
    echo "Refusing incomplete VM state: disk and XML must either both exist or both be absent." >&2
    exit 1
  fi
else
  printf 'Create QEMU VM %s with disk %s? [y/N] ' "$name" "$disk"
fi
read -r answer
[[ $answer == y || $answer == Y ]] || exit 0

mkdir -p -- "$vm_dir"
if (( ! resume )); then
  qemu-img create -f qcow2 "$disk" 80G
fi

sed \
  -e "s|@NAME@|$name|g" \
  -e "s|@DISK@|$disk|g" \
  -e "s|@ISO@|$iso|g" \
  "$(dirname -- "$0")/domain.xml.in" >"$xml"

xmllint --noout "$xml"
virsh --connect "$connection" define "$xml"
virsh --connect "$connection" start "$name"

echo "Created UEFI VM $name in $connection."
echo "Open it in GNOME Boxes or your preferred SPICE viewer."
