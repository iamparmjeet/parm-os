#!/bin/bash

set -euo pipefail

name=${1:-parm-virtualbox}
snapshot=${2:-}
[[ -n $snapshot ]] || {
  echo "Usage: $0 <vm-name> <snapshot-name>" >&2
  exit 2
}
[[ $snapshot =~ ^[a-zA-Z0-9._-]+$ ]] || {
  echo "Invalid snapshot name: $snapshot" >&2
  exit 1
}

VBoxManage snapshot "$name" take "$snapshot" \
  --description "Parm validation snapshot $snapshot"
