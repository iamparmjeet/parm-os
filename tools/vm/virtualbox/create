#!/bin/bash

set -euo pipefail

name=${1:-parm-virtualbox}
iso=${2:-$HOME/Downloads/omarchy-3.8.4.iso}
vm_dir=${PARM_VM_DIR:-$HOME/VMs/parm}
disk="$vm_dir/$name.vdi"

[[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || {
  echo "Invalid VM name: $name" >&2
  exit 1
}
[[ -f $iso ]] || {
  echo "Omarchy ISO not found: $iso" >&2
  exit 1
}
[[ -c /dev/vboxdrv ]] || {
  echo "VirtualBox host driver is unavailable. This helper will not repair it." >&2
  exit 1
}
VBoxManage showvminfo "$name" >/dev/null 2>&1 && {
  echo "VM already exists: $name" >&2
  exit 1
}

printf 'Create VirtualBox VM %s with disk %s? [y/N] ' "$name" "$disk"
read -r answer
[[ $answer == y || $answer == Y ]] || exit 0

mkdir -p -- "$vm_dir"
VBoxManage createvm --name "$name" --ostype ArchLinux_64 --register
VBoxManage modifyvm "$name" \
  --memory 8192 \
  --cpus 4 \
  --firmware efi \
  --graphicscontroller vmsvga \
  --vram 128 \
  --accelerate3d on \
  --nic1 nat \
  --audio-enabled on
VBoxManage createmedium disk --filename "$disk" --size 81920 --format VDI --variant Standard
VBoxManage storagectl "$name" --name SATA --add sata --controller IntelAhci
VBoxManage storageattach "$name" --storagectl SATA --port 0 --device 0 \
  --type hdd --medium "$disk"
VBoxManage storageattach "$name" --storagectl SATA --port 1 --device 0 \
  --type dvddrive --medium "$iso"

VBoxManage startvm "$name"
