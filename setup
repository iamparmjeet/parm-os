#!/bin/bash

set -euo pipefail

PARM_SOURCE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export PARM_SOURCE_DIR

# shellcheck source=lib/common.sh
source "$PARM_SOURCE_DIR/lib/common.sh"
# shellcheck source=lib/inspect.sh
source "$PARM_SOURCE_DIR/lib/inspect.sh"
# shellcheck source=lib/install.sh
source "$PARM_SOURCE_DIR/lib/install.sh"

usage() {
  cat <<'EOF'
Usage: ./setup <command> [options]

Commands:
  inspect              Inspect compatibility (may request sudo for /boot)
  install              Install Parm files beside Omarchy Quattro
  convert              Stage a complete Omarchy Quattro to Parm conversion
  update [version]     Update an existing Parm installation
  repair               Validate and restore product-owned files
  uninstall            Remove Parm after creating a configuration backup

Conversion options:
  --vm-test            Required by pre-release builds
  --dry-run            Print planned actions without changing anything
  --yes                Accept the final confirmation non-interactively
  --json               Machine-readable inspect output

Testing:
  PARM_TESTING=1 PARM_TEST_ROOT=/safe/fixture ./setup inspect
EOF
}

command_name=${1:-}
[[ -n $command_name ]] || {
  usage
  exit 2
}
shift

parm_parse_global_options "$@"
set -- "${PARM_REMAINING_ARGS[@]}"

if parm_is_testing; then
  parm_target_root >/dev/null
fi

case "$command_name" in
  inspect)
    parm_prepare_inspection_privileges
    parm_inspect "${PARM_JSON:-0}"
    ;;
  install)
    parm_require_vm_gate
    parm_prepare_inspection_privileges
    parm_install_stage
    ;;
  convert)
    parm_require_vm_gate
    parm_prepare_inspection_privileges
    parm_assert_compatible
    parm_confirm_conversion
    parm_install_stage
    parm_log "Parm is staged. Reboot to validate the Parm session."
    ;;
  update)
    parm_update "${1:-latest}"
    ;;
  repair)
    parm_repair
    ;;
  uninstall)
    parm_uninstall
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    parm_die "Unknown setup command: $command_name"
    ;;
esac
