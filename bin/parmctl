#!/bin/bash

set -euo pipefail

PARM_SHARE=${PARM_SHARE:-/usr/share/parm}
if [[ ! -d $PARM_SHARE ]]; then
  PARM_SHARE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fi

PARM_CONFIG=${PARM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/parm/config.json}
PARM_STATE=${PARM_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/parm}
PARM_CACHE=${PARM_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/parm}

die() {
  echo "parmctl: $*" >&2
  exit 1
}

config_validate() {
  jq -e '
    type == "object" and
    .schemaVersion == 1 and
    (.appearance.mode | IN("auto", "light", "dark")) and
    (.shell.bar.position | IN("top", "bottom")) and
    (.webapps | type == "array") and
    (.keybindings | type == "array")
  ' "$PARM_CONFIG" >/dev/null || die "configuration is invalid"
}

config_get() {
  local pointer=${1:-.}
  config_validate
  jq -r "$pointer" "$PARM_CONFIG"
}

config_set() {
  local pointer=${1:-}
  local value=${2:-}
  [[ $pointer == .* ]] || die "config pointer must be a jq path beginning with a dot"
  jq -e . >/dev/null <<<"$value" 2>/dev/null || value=$(jq -Rn --arg value "$value" '$value')
  local directory temp
  directory=$(dirname -- "$PARM_CONFIG")
  mkdir -p -- "$directory"
  temp=$(mktemp --tmpdir="$directory" .parm-config.XXXXXX)
  jq "$pointer = $value" "$PARM_CONFIG" >"$temp"
  jq -e '.schemaVersion == 1' "$temp" >/dev/null || {
    rm -f -- "$temp"
    die "updated configuration is invalid"
  }
  mv -f -- "$temp" "$PARM_CONFIG"
}

config_transform() {
  local directory temp
  directory=$(dirname -- "$PARM_CONFIG")
  mkdir -p -- "$directory"
  temp=$(mktemp --tmpdir="$directory" .parm-config.XXXXXX)
  jq "$@" "$PARM_CONFIG" >"$temp"
  jq -e '.schemaVersion == 1' "$temp" >/dev/null || {
    rm -f -- "$temp"
    die "updated configuration is invalid"
  }
  mv -f -- "$temp" "$PARM_CONFIG"
}

shell_ipc() {
  timeout --kill-after=1s 2s quickshell -p "$PARM_SHARE/shell" ipc call -- parm.shell "$@"
}

shell_ensure() {
  shell_ipc ping >/dev/null 2>&1 && return 0

  setsid quickshell -n -d -p "$PARM_SHARE/shell" >/dev/null 2>&1
  local attempt
  for attempt in {1..30}; do
    shell_ipc ping >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  die "Parm shell did not become ready"
}

shell_command() {
  case "${1:-}" in
    start)
      setsid quickshell -n -d -p "$PARM_SHARE/shell"
      ;;
    stop)
      quickshell kill -p "$PARM_SHARE/shell" --any-display
      ;;
    restart)
      quickshell kill -p "$PARM_SHARE/shell" --any-display >/dev/null 2>&1 || true
      setsid quickshell -n -d -p "$PARM_SHARE/shell"
      ;;
    ping)
      shell_ipc ping
      ;;
    launcher)
      shell_ensure
      shell_ipc toggleLauncher
      ;;
    *)
      die "usage: parmctl shell start|stop|restart|ping|launcher"
      ;;
  esac
}

theme_mode() {
  local configured now light_at dark_at
  configured=$(config_get '.appearance.mode')
  if [[ $configured != auto ]]; then
    printf '%s\n' "$configured"
    return
  fi
  now=$(TZ="$(config_get '.appearance.timezone')" date +%H:%M)
  light_at=$(config_get '.appearance.lightAt')
  dark_at=$(config_get '.appearance.darkAt')
  if [[ $now < "$light_at" || $now == "$dark_at" || $now > "$dark_at" ]]; then
    printf 'dark\n'
  else
    printf 'light\n'
  fi
}

theme_command() {
  case "${1:-}" in
    apply)
      "$PARM_SHARE/themes/apply" "${2:-$(theme_mode)}"
      ;;
    mode)
      theme_mode
      ;;
    status)
      jq -n --arg mode "$(theme_mode)" --arg wallpaper "$(config_get '.appearance.wallpaper')" \
        '{mode:$mode,wallpaper:$wallpaper}'
      ;;
    *)
      die "usage: parmctl theme apply [light|dark]|mode|status"
      ;;
  esac
}

wallpaper_command() {
  case "${1:-}" in
    set)
      local source=${2:-}
      [[ -f $source ]] || die "wallpaper does not exist: $source"
      local destination="$HOME/.local/share/parm/wallpapers/$(basename -- "$source")"
      mkdir -p -- "$(dirname -- "$destination")"
      install -m 0644 "$source" "$destination"
      config_set '.appearance.wallpaper' "$(jq -Rn --arg value "$destination" '$value')"
      theme_command apply
      ;;
    current)
      config_get '.appearance.wallpaper'
      ;;
    *)
      die "usage: parmctl wallpaper set <path>|current"
      ;;
  esac
}

webapp_find() {
  local id=$1
  jq -e --arg id "$id" '.webapps[] | select(.id == $id and .enabled)' "$PARM_CONFIG"
}

webapp_launch() {
  local id=$1 entry url tag address
  entry=$(webapp_find "$id") || die "unknown or disabled webapp: $id"
  url=$(jq -r '.url' <<<"$entry")
  tag="parm-webapp-$id"
  address=$(hyprctl clients -j 2>/dev/null |
    jq -r --arg tag "$tag" '.[] | select((.tags // []) | index($tag)) | .address' |
    head -1)
  if [[ -n $address ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
    return
  fi

  local before
  before=$(hyprctl clients -j 2>/dev/null |
    jq -r '.[] | select((.class // .initialClass // "") | test("zen"; "i")) | .address')
  uwsm-app -- zen-browser --new-window "$url" >/dev/null 2>&1 &

  local attempt candidate
  for attempt in {1..50}; do
    sleep 0.1
    candidate=$(hyprctl clients -j 2>/dev/null |
      jq -r '.[] | select((.class // .initialClass // "") | test("zen"; "i")) | .address' |
      while IFS= read -r candidate_address; do
        grep -Fxq "$candidate_address" <<<"$before" || {
          printf '%s\n' "$candidate_address"
          break
        }
      done)
    if [[ -n $candidate ]]; then
      hyprctl dispatch \
        "hl.dsp.window.tag({ tag = \"+$tag\", window = \"address:$candidate\" })" \
        >/dev/null
      return
    fi
  done

  echo "parmctl: Zen opened, but its window could not be tagged as $id" >&2
}

webapp_sync_desktop() {
  local id=$1 entry desktop applications
  entry=$(jq -e --arg id "$id" '.webapps[] | select(.id == $id)' "$PARM_CONFIG") ||
    return 0
  applications="$HOME/.local/share/applications"
  desktop="$applications/parm-webapp-$id.desktop"
  mkdir -p -- "$applications"
  if [[ $(jq -r '.enabled' <<<"$entry") != true ]]; then
    rm -f -- "$desktop"
    return
  fi
  local name icon
  name=$(jq -r '.name' <<<"$entry")
  icon=$(jq -r '.icon' <<<"$entry")
  {
    printf '[Desktop Entry]\n'
    printf 'Type=Application\n'
    printf 'Name=%s\n' "$name"
    printf 'Exec=parmctl webapp launch %s\n' "$id"
    printf 'Icon=%s\n' "$icon"
    printf 'Terminal=false\n'
    printf 'Categories=Network;WebBrowser;\n'
    printf 'StartupNotify=true\n'
  } >"$desktop"
}

webapp_add() {
  local id=${1:-} name=${2:-} url=${3:-} keybinding=${4:-}
  [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid webapp id: $id"
  [[ -n $name ]] || die "webapp name is required"
  [[ $url =~ ^https?:// ]] || die "webapp URL must begin with http:// or https://"
  jq -e --arg id "$id" '.webapps[] | select(.id == $id)' "$PARM_CONFIG" >/dev/null &&
    die "webapp already exists: $id"
  config_transform \
    --arg id "$id" \
    --arg name "$name" \
    --arg url "$url" \
    --arg keybinding "$keybinding" \
    '.webapps += [{
      id:$id,
      name:$name,
      url:$url,
      icon:"applications-internet",
      keybinding:$keybinding,
      enabled:true
    }]'
  webapp_sync_desktop "$id"
}

webapp_edit() {
  local id=${1:-} field=${2:-} value=${3:-}
  jq -e --arg id "$id" '.webapps[] | select(.id == $id)' "$PARM_CONFIG" >/dev/null ||
    die "unknown webapp: $id"
  case "$field" in
    name|url|icon|keybinding)
      config_transform --arg id "$id" --arg field "$field" --arg value "$value" \
        '(.webapps[] | select(.id == $id))[$field] = $value'
      ;;
    enabled)
      [[ $value == true || $value == false ]] || die "enabled must be true or false"
      config_transform --arg id "$id" --argjson value "$value" \
        '(.webapps[] | select(.id == $id)).enabled = $value'
      ;;
    *)
      die "editable fields: name, url, icon, keybinding, enabled"
      ;;
  esac
  webapp_sync_desktop "$id"
}

webapp_remove() {
  local id=${1:-}
  config_transform --arg id "$id" '.webapps |= map(select(.id != $id))'
  rm -f -- "$HOME/.local/share/applications/parm-webapp-$id.desktop"
}

webapp_command() {
  case "${1:-}" in
    list) config_get '.webapps' ;;
    launch) webapp_launch "${2:-}" ;;
    add) shift; webapp_add "$@" ;;
    edit) shift; webapp_edit "$@" ;;
    remove) webapp_remove "${2:-}" ;;
    *) die "usage: parmctl webapp add|edit|remove|list|launch <id>" ;;
  esac
}

brightness_command() {
  local delta=${1:-}
  [[ $delta =~ ^[+-][0-9]+$ ]] || die "brightness requires +N or -N"
  local monitor
  monitor=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.monitor // ""')
  if [[ $monitor == eDP-* ]]; then
    brightnessctl set "${delta}%"
  else
    local current next
    current=$(ddcutil getvcp 10 --brief 2>/dev/null | awk '{print $4}' | tr -d ',')
    [[ $current =~ ^[0-9]+$ ]] || die "could not read DDC brightness"
    next=$((current + delta))
    ((next < 1)) && next=1
    ((next > 100)) && next=100
    ddcutil setvcp 10 "$next"
  fi
}

doctor_command() {
  local failed=0 check command_name
  local commands=(hyprland uwsm quickshell matugen jq zen-browser alacritty dolphin kate)
  for command_name in "${commands[@]}"; do
    if command -v "$command_name" >/dev/null 2>&1; then
      printf 'ok      %s\n' "$command_name"
    else
      printf 'missing %s\n' "$command_name"
      failed=1
    fi
  done
  if config_validate; then
    printf 'ok      configuration\n'
  else
    failed=1
  fi
  if [[ ${1:-} == --session ]]; then
    shell_ipc ping >/dev/null 2>&1 && printf 'ok      shell IPC\n' || {
      printf 'failed  shell IPC\n'
      failed=1
    }
  fi
  return "$failed"
}

backup_command() {
  case "${1:-}" in
    list)
      find "$PARM_STATE/backups" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -r
      ;;
    create)
      die "run ./setup repair from the Parm source checkout to create a system backup"
      ;;
    restore)
      die "configuration restore is intentionally manual in the development build"
      ;;
    *) die "usage: parmctl backup create|list|restore" ;;
  esac
}

dev_command() {
  case "${1:-}" in
    status) mise current ;;
    apply)
      mkdir -p -- "$HOME/.config/mise"
      jq -r '.development.mise | to_entries[] | "[tools.\"\(.key)\"]\n\(.key) = \"\(.value)\""' \
        "$PARM_CONFIG"
      die "mise apply preview generated; writing is deferred to Settings confirmation"
      ;;
    update) die "tool version updates require an explicit config edit" ;;
    *) die "usage: parmctl dev status|apply|update" ;;
  esac
}

case "${1:-}" in
  settings)
    setsid quickshell -n -d -p "$PARM_SHARE/settings"
    ;;
  doctor)
    shift
    doctor_command "$@"
    ;;
  shell)
    shift
    shell_command "$@"
    ;;
  config)
    subcommand=${2:-}
    case "$subcommand" in
      get) config_get "${3:-.}" ;;
      set) config_set "${3:-}" "${4:-}" ;;
      validate) config_validate && echo "valid" ;;
      *) die "usage: parmctl config get|set|validate" ;;
    esac
    ;;
  wallpaper)
    shift
    wallpaper_command "$@"
    ;;
  theme)
    shift
    theme_command "$@"
    ;;
  webapp)
    shift
    webapp_command "$@"
    ;;
  brightness)
    shift
    brightness_command "$@"
    ;;
  dev)
    shift
    dev_command "$@"
    ;;
  backup)
    shift
    backup_command "$@"
    ;;
  recovery)
    printf 'Conversion phase: %s\n' "$(cat /var/lib/parm/conversion-phase 2>/dev/null || echo not-installed)"
    ;;
  update|repair)
    die "run ./setup $1 from a verified Parm release checkout"
    ;;
  *)
    cat <<'EOF'
Usage: parmctl <command>

Commands: settings, doctor, shell, config, wallpaper, theme, webapp,
          brightness, dev, backup, recovery, update, repair
EOF
    ;;
esac
